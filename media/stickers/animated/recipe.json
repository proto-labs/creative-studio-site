{
  "id": "flat-vector-animated",
  "title": "Flat vector sticker packs, animated",
  "license": "CC0-1.0",
  "attribution": "Motion added to the CC0 flat vector stickers of this repository by its sticker-pack tool; original work dedicated to the public domain under CC0 1.0.",
  "source": "../manifest.json",
  "fps": 30,
  "duration": 2,
  "suffix": "-animated",
  "tags": ["animated"],
  "stickers": {
    "confetti": { "motion": "float", "duration": 3 },
    "party-popper": { "motion": "tada" },
    "trophy": { "motion": "bounce" },
    "heart": { "motion": "heartbeat" },
    "fire": { "motion": "wiggle", "amount": 0.6, "anchor": [256, 440] },
    "sparkles": { "motion": "pulse", "duration": 1.5 },
    "curved-arrow": { "motion": "float", "amount": 0.8 },
    "straight-arrow": { "motion": "float", "amount": 0.8 },
    "starburst": { "motion": "spin", "duration": 8 },
    "ribbon-banner": { "motion": "pulse", "amount": 0.6 },
    "speech-bubble": { "motion": "bounce", "amount": 0.7 },
    "thought-bubble": { "motion": "float", "duration": 3 },
    "checkmark": { "motion": "pulse" },
    "calendar": { "motion": "wiggle", "amount": 0.5 },
    "clock": { "motion": "wiggle", "amount": 0.6 },
    "lightbulb": { "motion": "pulse", "duration": 1.5 },
    "rocket": { "motion": "float", "duration": 1.5 },
    "target": { "motion": "pulse", "amount": 0.8 },
    "sun": { "motion": "spin", "duration": 10 },
    "cloud": { "motion": "float", "duration": 4 },
    "lightning": { "motion": "wiggle", "amount": 0.5, "duration": 1.5 },
    "thumbs-up": { "motion": "bounce", "amount": 0.7 },
    "hundred-points": { "motion": "tada" },
    "raised-hands": { "motion": "bounce" },
    "eyes": { "motion": "wiggle", "amount": 0.5 },
    "smiling-face": { "motion": "bounce", "amount": 0.6 },
    "laughing-face": { "motion": "wiggle", "amount": 0.7 },
    "wow-face": { "motion": "pulse" },
    "winking-face": { "motion": "swing", "amount": 0.4, "anchor": [256, 256] },
    "cool-face": { "motion": "swing", "amount": 0.5, "anchor": [256, 256] },
    "thinking-face": { "motion": "float", "duration": 3 },
    "crying-laughing-face": { "motion": "wiggle" },
    "heart-sparkle": { "motion": "heartbeat" },
    "broken-heart": { "motion": "wiggle", "amount": 0.5 },
    "star": { "motion": "pulse" },
    "crown": { "motion": "float", "amount": 0.7 },
    "gem": { "motion": "pulse", "amount": 0.7 },
    "medal": { "motion": "swing", "anchor": [256, 60] },
    "money-bag": { "motion": "bounce", "amount": 0.8 },
    "bell": { "motion": "swing", "anchor": [256, 70] }
  }
}
